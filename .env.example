# ============================================================
# Bikoom Store — environment variables
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file.
# ============================================================

# ---------- Server (Express API) ----------
PORT=3001

# Supabase project (Project Settings → API)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only. Never expose to the browser.

# ---------- Client (Vite — must be prefixed with VITE_) ----------
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ---------- Google OAuth (configured inside Supabase, not here) ----------
# Supabase Dashboard → Authentication → Providers → Google
#   - Google Cloud Console: create OAuth 2.0 client (Authorized redirect URI
#     = https://YOUR-PROJECT-REF.supabase.co/auth/v1/callback)
#   - Paste Client ID + Client Secret into Supabase.
# Supabase Dashboard → Authentication → URL Configuration:
#   - Site URL = http://localhost:5173 (dev) / your production URL
#   - Redirect URLs = http://localhost:5173/auth/callback, plus production equivalent
GOOGLE_OAUTH_CLIENT_ID=      # only used if you wire a custom OAuth flow; Supabase stores it by default
GOOGLE_OAUTH_CLIENT_SECRET=

# ---------- Transactional Email (choose Resend OR Mailgun) ----------
# Option A: Resend (recommended - easy 1-key setup from resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM=Bikoom Store <onboarding@resend.dev>

# Option B: Mailgun
MAILGUN_API_KEY=key-xxxxxxxxxxxxxxxxxxxxxxx
MAILGUN_DOMAIN=mg.yourdomain.com
MAILGUN_FROM=Bikoom Store <no-reply@mg.yourdomain.com>
MAILGUN_REGION=us            # us | eu

# Where store notifications are emailed (order requests, waybill requests)
CONTACT_EMAIL=you@example.com

# Comma-separated list of Google account emails that get admin access
# to /admin (checked in addition to profiles.is_admin).
ADMIN_EMAILS=you@gmail.com

# ---------- Store ----------
# WhatsApp number in international format, no + or spaces.
# This is the number order requests and CTA buttons open a chat with.
WHATSAPP_NUMBER=2348000000000
VITE_WHATSAPP_NUMBER=2348000000000
